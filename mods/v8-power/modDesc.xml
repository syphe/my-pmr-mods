<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- desc version defines the min feature set of the game needed to run the mod -->
<modDesc titleId="pmr1" descVersion="0">

    <name>V8 Power</name>
    <type>Vehicle</type>

    <vehicles>
        <vdef path="ford_mustang_v8/data/ford_mustang_v8.vdef" />
        <vdef path="chevrolet_camaro_v8/data/chevrolet_camaro_v8.vdef" />
        <vdef path="toyota_supra_v8/data/toyota_supra_v8.vdef" />
    </vehicles>

    <vehicleClass>
		<class name="V8 Power" image="icons/classIcon_v8_power.png"/>
	</vehicleClass>

    <!-- defines the mod author -->
    <author>syphe</author>

    <!-- defines the current version-->
    <version>1.0.0.0</version>

    <!-- defines if mod is supported multiplayer -->
    <multiplayer supported="true" />

    <!-- defines the mod title shown ingame. multilanguage support using the shortcuts like fr, es, cz, jp, etc -->
    <title>
        <en>V8 Power</en>
    </title>

    <!-- defines the mod description shown ingame. multilanguage support using the shortcuts like fr, es, cz, jp, etc -->
    <description>
        <en>
            <![CDATA[This mod contains a new class of cars based on the in-game GT4 Camaro, Mustang and Supra.
            
            - Each car shares the same engine, drivetrain, and aero parameters
            - The engine is tuned to roughly 600hp @ 7500rpm
            - The drivetrain and aero parameters are currently the same as the GT4 Mustang that this mod is based on
            - The Supra now sounds like a V8
            - Each car is using the older GT car set of assists
            - Liveries are currently placeholders]]>
        </en>
    </description>

    <!-- defines the icon shown ingame (path relative to mod base folder) -->
    <iconFilename>icon.png</iconFilename>

    <!-- <sourceFiles>
        <sourceFile filename="scripts/helloWorld.lua"/>
    </sourceFiles> -->
</modDesc>