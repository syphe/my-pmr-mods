#V8 Supercar Suspension
#Based on current gen Mustang/Camaro/Supra V8SC specifications
#Front motion ratio= .850
#Rear motion ratio= .800
#wheelbase= 2.704
#front track= 1.568
#rear track= 1.580

#   Hadron and ISO 8855
#   +x = forward
#   +y = left
#   +z = up
#   +pitch = nose down
#   +yaw = nose left
#   +roll = right

INCLUDE "Suspension/suspension_parts.0.hadron"

#############################################################
# FRONT

TOP_ARMS_ON_UPRIGHT_X = 1.312
TOP_ARMS_ON_UPRIGHT_X_RANGE = "-0.04 0.04 0.005"
TOP_ARMS_ON_UPRIGHT_Y = 0.720
TOP_ARMS_ON_UPRIGHT_Y_RANGE = "-0.04 0.04 0.005"
TOP_ARMS_ON_UPRIGHT = "$(TOP_ARMS_ON_UPRIGHT_X)   $(LAT)$(TOP_ARMS_ON_UPRIGHT_Y)    0.178"        #Upper ball joint on upright

#TOP_ARMS_ON_UPRIGHT =	"	1.307	$(LAT)0.720	0.178	"
TOP_F_ARM_ON_BODY =	"	1.456	$(LAT)0.505	0.129	"
TOP_R_ARM_ON_BODY =	"	1.240	$(LAT)0.505	0.119	"
BOTTOM_ARMS_ON_UPRIGHT =	"	1.362	$(LAT)0.777	-0.128	"
BOTTOM_F_ARM_ON_BODY =	"	1.337	$(LAT)0.431	-0.145	"
BOTTOM_R_ARM_ON_BODY =	"	0.998	$(LAT)0.431	-0.135	"
TIEROD_ON_BODY =	"	1.449	$(LAT)0.450	-0.075	"
TIEROD_ON_UPRIGHT =	"	1.488	$(LAT)0.788	-0.040	"
PUSHROD_ON_BODY =	"	1.313	$(LAT)0.550	0.225	"
PUSHROD_ON_B_ARM =	"	1.363	$(LAT)0.697	-0.128	"

#V8 Supercar typical alignment - less camber than GT3/GT4, slight toe-in for stability under power
CAMBER =					-1.5
TOE	=						0.1 #degrees per wheel. + is toe in. - is toe out (1mm toe = .8 deg toe across 20")

#FRONT SETUP
CAMBER_RANGE =				"-3.0 0 0.1"
TOE_RANGE =					"-0.3 0.5 0.05"
STIFFNESS_RANGE =			"160000 220000 10000"
SLOW_BUMP_RANGE =			"15000 30000 1000"
SLOW_REBOUND_RANGE =		"15000 30000 1000"
FAST_BUMP_RANGE =			"7000 13000 500"
FAST_REBOUND_RANGE =		"7000 13000 500"
BUMPSTOP_STIFFNESS_RANGE = "500000 900000 50000"
BUMPSTOP_SIZE_RANGE = "0.0 0.040 0.005"

# FRONT SPRING DAMPER - V8SC stiffer than GT4, but softer than GT3 due to heavier car needing compliance
STIFFNESS =                 190000             # Pure Spring rate in N/m (V8SC typically 180-200k)
SLOW_BUMP =                 21000            #Damping rate in N/m/s - higher for V8SC weight
SLOW_REBOUND =          20000           #Damping rate in N/m/s
FAST_BUMP =                 10000               #Damping rate in N/m/s - controlled bump response
FAST_REBOUND =          10000              #Damping rate in N/m/s
KNEE_BUMP =					0.05                # Meters/sec bump damper switches to FAST damping (the valve blow-off)
KNEE_REBOUND =			0.05               # Meters/sec rebound damper switches to FAST damping (the valve blow-off)
COMPRESSION_TRAVEL =    0.060        #Meters of bump travel. Free travel is this - bumpstop length.
EXTENSION_TRAVEL =          0.060         #Meters of rebound travel
BUMPSTOP_STIFFNESS =     650000  #Spring Rate N/M
BUMPSTOP_DAMPING =      11000        # N/m/s
BUMPSTOP_SIZE =   0.018         #length in meters.

#V8SC realistic unsprung masses
UPRIGHT_MASS =				5.5   #Kg - realistic mass
UPRIGHT_INERTIA =			"0.30	0.30	0.30"
UPRIGHT_LOCATION =		"1.352   $(LAT)0.784    0.0" #Center of upright , or Hub face ?

WHEEL_MASS =				14.0   #Kg - realistic wheel+tire mass
WHEEL_LOCATION =		"1.406   $(LAT)0.800    0.0" #should be 1/2 the wheel base (X) and 1/2 the track (Y).
WHEEL_INERTIA =				"0.8	1.9	0.8"

#############################################################
# FL CORNER
LAT=+
CORNER=FL
INCLUDE "Suspension/double_wishbone.1F.hadron"

#############################################################
# FR CORNER
LAT=-
CORNER=FR
INCLUDE "Suspension/double_wishbone.1F.hadron"

#############################################################
# REAR
TOP_ARMS_ON_UPRIGHT =	"	-1.330	$(LAT)0.791	0.155	"
TOP_F_ARM_ON_BODY =	"	-1.129	$(LAT)0.538	0.100	"
TOP_R_ARM_ON_BODY =	"	-1.330	$(LAT)0.538	0.100	"
BOTTOM_ARMS_ON_UPRIGHT =	"	-1.373	$(LAT)0.792	-0.143	"
BOTTOM_F_ARM_ON_BODY =	"	-1.151	$(LAT)0.387	-0.140	"
BOTTOM_R_ARM_ON_BODY =	"	-1.436	$(LAT)0.390	-0.160	"
TIEROD_ON_BODY =	"	-1.573	$(LAT)0.389	-0.102	"
TIEROD_ON_UPRIGHT =	"	-1.532	$(LAT)0.791	-0.069	"
PUSHROD_ON_BODY =	"	-1.352	$(LAT)0.560	0.240	"
PUSHROD_ON_B_ARM =	"	-1.352	$(LAT)0.750	-0.140	"

#V8SC rear alignment - minimal camber for traction, minimal toe for stability
CAMBER =					-1.3
TOE	=						0.10

#REAR SETUP
CAMBER_RANGE =				"-2.5 0 0.1"
TOE_RANGE =					"-0.2 0.5 0.05"
STIFFNESS_RANGE =			"160000 220000 10000"
SLOW_BUMP_RANGE =			"12000 28000 1000"
SLOW_REBOUND_RANGE =		"12000 28000 1000"
FAST_BUMP_RANGE =			"5000 12000 500"
FAST_REBOUND_RANGE =		"5000 12000 500"
BUMPSTOP_STIFFNESS_RANGE = "500000 900000 50000"
BUMPSTOP_SIZE_RANGE = "0.0 0.040 0.005"

# REAR SPRING DAMPER - Slightly softer than front to aid traction and rear stability under power
STIFFNESS =                 185000
SLOW_BUMP =                 17000
SLOW_REBOUND =              18000
FAST_BUMP =                 7000    #Softer for V8SC traction needs
FAST_REBOUND =              8000
KNEE_BUMP =					0.05
KNEE_REBOUND =			    0.05
COMPRESSION_TRAVEL =        0.065
EXTENSION_TRAVEL =          0.065
BUMPSTOP_STIFFNESS =        650000
BUMPSTOP_DAMPING =          11000
BUMPSTOP_SIZE =   0.018

UPRIGHT_MASS =				6.0   #Kg - realistic mass
UPRIGHT_INERTIA =			"0.30	0.30	0.30"
UPRIGHT_LOCATION =			"-1.352   $(LAT)0.790    0.0"

WHEEL_MASS =				16.0   #Kg - realistic rear wheel+tire mass (slightly heavier)
WHEEL_LOCATION =			"-1.406   $(LAT)0.800    0.0"
WHEEL_INERTIA =				"0.90	1.9	0.9"

#############################################################
# RL CORNER
LAT=+
CORNER=RL
INCLUDE "Suspension/double_wishbone.1R.hadron"

#############################################################
# RR CORNER
LAT=-
CORNER=RR
INCLUDE "Suspension/double_wishbone.1R.hadron"

# Front ARB - Stiffer than GT4, balanced front/rear for V8SC characteristics
X_TAG=F
X_ARB =			1.6
Y_ARB =			0.764
Z_ARB =			0.2
X_ARB_LINK =	1.348
Z_ARB_LINK =	-0.153
ARB_STIFFNESS =	9.0e4
ARB_DAMPING =   1.0e3
ARB_RANGE = "5.0e4 15.0e4 1.0e4"
INCLUDE "Suspension/antirollbar.2.hadron"

# Rear ARB - Slightly softer than front for RWD traction
X_TAG=R
X_ARB =			-1.0
Y_ARB =			0.733
Z_ARB =			0.2
X_ARB_LINK =	-1.266
Z_ARB_LINK =	-0.153
ARB_STIFFNESS =	7.0e4
ARB_DAMPING =   1.0e3
ARB_RANGE = "4.0e4 12.0e4 1.0e4"
INCLUDE "Suspension/antirollbar.2.hadron"

#Spring platform adjustment ranges###################
Entity * l_range_channel_filter_w_binding
	channel:range "-0.03 0.03 0.001"
	channel:name "FL-spring-platform"
	channel:initial 0.0

Entity * l_range_channel_filter_w_binding
	channel:range "-0.03 0.03 0.001"
	channel:name "FR-spring-platform"
	channel:initial 0.0

Entity * l_range_channel_filter_w_binding
	channel:range "-0.03 0.03 0.001"
	channel:name "RL-spring-platform"
	channel:initial 0.002

Entity * l_range_channel_filter_w_binding
	channel:range "-0.03 0.03 0.001"
	channel:name "RR-spring-platform"
	channel:initial 0.002
