#Ford Mustang GT3
#Front motion ratio= .800
#Rear motion ratio= .800
#wheelbase= 2.720 (1.360)
#front track= 1.703 (0.851)
#rear track= 1.660 (0.830)

#   Hadron and ISO 8855
#   +x = forward
#   +y = left
#   +z = up
#   +pitch = nose down
#   +yaw = nose left
#   +roll = right

INCLUDE "Suspension/suspension_parts.0.hadron"

#############################################################
# FRONT

TOP_ARMS_ON_UPRIGHT_X = 1.330
TOP_ARMS_ON_UPRIGHT_X_RANGE = "-0.04 0.04 0.005"
TOP_ARMS_ON_UPRIGHT_Y = 0.760
TOP_ARMS_ON_UPRIGHT_Y_RANGE = "-0.04 0.04 0.005"
TOP_ARMS_ON_UPRIGHT = "$(TOP_ARMS_ON_UPRIGHT_X)   $(LAT)$(TOP_ARMS_ON_UPRIGHT_Y)    0.140"        #Upper ball joint on upright

#TOP_ARMS_ON_UPRIGHT =	"	1.320	$(LAT)0.760	0.140	"
TOP_F_ARM_ON_BODY =	"	1.455	$(LAT)0.515	0.120	"
TOP_R_ARM_ON_BODY =	"	1.221	$(LAT)0.515	0.100	"
BOTTOM_ARMS_ON_UPRIGHT =	"	1.375	$(LAT)0.793	-0.145	"
BOTTOM_F_ARM_ON_BODY =	"	1.604	$(LAT)0.394	-0.145	"
BOTTOM_R_ARM_ON_BODY =	"	1.276	$(LAT)0.367	-0.145	"
TIEROD_ON_BODY =	"	1.460	$(LAT)0.460	-0.070	"
TIEROD_ON_UPRIGHT =	"	1.488	$(LAT)0.785	-0.060	"
PUSHROD_ON_BODY =	"	1.360	$(LAT)0.530	0.190	"
PUSHROD_ON_B_ARM =	"	1.360	$(LAT)0.770	-0.142	"

CAMBER =					-2.8
TOE	=						-0.1 #degrees per wheel. + is toe in. - is toe out (1mm toe = .8 deg toe across 20")

#FRONT SETUP
CAMBER_RANGE =				"-4.0 0 0.1"
TOE_RANGE =					"-0.5 0.5 0.05"
STIFFNESS_RANGE =			"240000 340000 10000"
SLOW_BUMP_RANGE =			"10000 30000 1000"
SLOW_REBOUND_RANGE =		"10000 30000 1000"
FAST_BUMP_RANGE =			"5000 15000 500"
FAST_REBOUND_RANGE =		"5000 15000 500"
BUMPSTOP_STIFFNESS_RANGE = "600000 1000000 100000"
BUMPSTOP_SIZE_RANGE = "0.0 0.060 0.005"

# FRONT SPRING DAMPER
STIFFNESS =                 240000             # Pure Spring rate in N/m
SLOW_BUMP =                 13000            #Damping rate in N/m/s
SLOW_REBOUND =          15000           #Damping rate in N/m/s
FAST_BUMP =                 6500               #Damping rate in N/m/s range is 5600-10,000
FAST_REBOUND =          9500              #Damping rate in N/m/s
KNEE_BUMP =					0.05                # Meters/sec bump damper switches to FAST damping (the valve blow-off)
KNEE_REBOUND =			0.05               # Meters/sec rebound damper switches to FAST damping (the valve blow-off)
COMPRESSION_TRAVEL =    0.055        #Meters of bump travel. Free travel is this - bumpstop length.
EXTENSION_TRAVEL =          0.055         #Meters of rebound travel
BUMPSTOP_STIFFNESS =     600000  #Spring Rate N/M
BUMPSTOP_DAMPING =      11000        # N/m/s
BUMPSTOP_SIZE =   0.015         #length in meters.

#UPRIGHT_MASS =				26.0
UPRIGHT_MASS =				44.0   #Kg
UPRIGHT_INERTIA =			"0.310	0.310	0.290"
UPRIGHT_LOCATION =		"1.360   $(LAT)0.831    0.0" #Center of upright , or Hub face ?

WHEEL_MASS =				22.0   #Kg
WHEEL_LOCATION =		"1.360   $(LAT)0.851    0.0" #should be 1/2 the wheel base (X) and 1/2 the track (Y).
WHEEL_INERTIA =				"0.724	1.292	0.724"

#############################################################
# FL CORNER
LAT=+
CORNER=FL
INCLUDE "Suspension/double_wishbone.1F.hadron"

#############################################################
# FR CORNER
LAT=-
CORNER=FR
INCLUDE "Suspension/double_wishbone.1F.hadron"

#############################################################
# REAR
TOP_ARMS_ON_UPRIGHT =	"	-1.338	$(LAT)0.778	0.140	"
TOP_F_ARM_ON_BODY =	"	-1.137	$(LAT)0.571	0.105	"
TOP_R_ARM_ON_BODY =	"	-1.338	$(LAT)0.571	0.105	"
BOTTOM_ARMS_ON_UPRIGHT =	"	-1.381	$(LAT)0.820	-0.155	"
BOTTOM_F_ARM_ON_BODY =	"	-1.159	$(LAT)0.394	-0.165	"
BOTTOM_R_ARM_ON_BODY =	"	-1.444	$(LAT)0.367	-0.165	"
TIEROD_ON_BODY =	"	-1.581	$(LAT)0.460	-0.055	"
TIEROD_ON_UPRIGHT =	"	-1.540	$(LAT)0.790	-0.024	"
PUSHROD_ON_BODY =	"	-1.360	$(LAT)0.590	0.205	"
PUSHROD_ON_B_ARM =	"	-1.360	$(LAT)0.770	-0.157	"

CAMBER =					-2.6
TOE	=						0.20

#REAR SETUP
CAMBER_RANGE =				"-3.5 0 0.1"
TOE_RANGE =					"-0.5 0.5 0.1"
STIFFNESS_RANGE =			"200000 300000 10000"
SLOW_BUMP_RANGE =			"10000 30000 1000"
SLOW_REBOUND_RANGE =		"10000 30000 1000"
FAST_BUMP_RANGE =			"5000 15000 500"
FAST_REBOUND_RANGE =		"5000 15000 500"
BUMPSTOP_STIFFNESS_RANGE = "600000 1000000 100000"
BUMPSTOP_SIZE_RANGE = "0.0 0.060 0.005"

# REAR SPRING DAMPER
STIFFNESS =                 210000
SLOW_BUMP =                 12000
SLOW_REBOUND =              17000
FAST_BUMP =                 5500    #range is 5600-10,000
FAST_REBOUND =              9000 #range is 7200-16,500
KNEE_BUMP =					0.05
KNEE_REBOUND =			    0.05
COMPRESSION_TRAVEL =        0.065
EXTENSION_TRAVEL =          0.065
BUMPSTOP_STIFFNESS =        600000
BUMPSTOP_DAMPING =          11000
BUMPSTOP_SIZE =   0.015

#UPRIGHT_MASS =				30.0
UPRIGHT_MASS =				50.0
UPRIGHT_INERTIA =			"0.380	0.380	0.350"
UPRIGHT_LOCATION =			"-1.360   $(LAT)0.825    0.0"

WHEEL_MASS =				24.0
WHEEL_LOCATION =			"-1.360   $(LAT)0.845    0.0"
WHEEL_INERTIA =				"0.875	1.446	0.875"

#############################################################
# RL CORNER
LAT=+
CORNER=RL
INCLUDE "Suspension/double_wishbone.1R.hadron"

#############################################################
# RR CORNER
LAT=-
CORNER=RR
INCLUDE "Suspension/double_wishbone.1R.hadron"

# Front ARB ###############################################
X_TAG=F
X_ARB =			1.6
Y_ARB =			0.764
Z_ARB =			0.2
X_ARB_LINK =	1.348
Z_ARB_LINK =	-0.153
ARB_STIFFNESS =	6.0e4
ARB_DAMPING =   1.0e3
ARB_RANGE = "1.0e4 20.0e4 1.0e4"
INCLUDE "Suspension/antirollbar.2.hadron"

# Rear ARB ###############################################
X_TAG=R
X_ARB =			-1.0
Y_ARB =			0.733
Z_ARB =			0.2
X_ARB_LINK =	-1.266
Z_ARB_LINK =	-0.153
ARB_STIFFNESS =	6.0e4
ARB_DAMPING =   1.0e3
ARB_RANGE = "1.0e4 20.0e4 1.0e4"
INCLUDE "Suspension/antirollbar.2.hadron"

#Spring platform adjustemnt ranges###################
Entity * l_range_channel_filter_w_binding
	channel:range "-0.03 0.03 0.001"
	channel:name "FL-spring-platform"
	channel:initial 0.0

Entity * l_range_channel_filter_w_binding
	channel:range "-0.03 0.03 0.001"
	channel:name "FR-spring-platform"
	channel:initial 0.0

Entity * l_range_channel_filter_w_binding
	channel:range "-0.03 0.03 0.001"
	channel:name "RL-spring-platform"
	channel:initial 0.003

Entity * l_range_channel_filter_w_binding
	channel:range "-0.03 0.03 0.001"
	channel:name "RR-spring-platform"
	channel:initial 0.003