
INCLUDE "Tire_AI/GT4_Tires_AI.hadron"

PRELOAD "Tire/linear.hadron"

# Pirelli DH Sicks 305/660 R18 & 305/680 R18
T#Hard compound tire (default)
Pattern T_F_TIRE_EVAL T_F_BASELINE_TIRE
	asperity:scale "3.0 3.0 "
	tire:width 0.305                # Tyre section width (m) (used by STM) - 0.021 shoulder in tire.rg gives 0.306m tread
	tire:radius 0.330
	tire:pressure 145000.0
	tire:model "GT4_Front_hard"

Pattern T_R_TIRE_EVAL T_R_BASELINE_TIRE
	asperity:scale "4.0 4.0"
	tire:width 0.325                # Tyre section width (m) (used by STM) - 0.037 shoulder in tire.rg gives 0.310m tread
	tire:radius 0.340
	tire:pressure 145000.0
	tire:model "GT4_Rear_hard"

#Medium Compound tire
Pattern GT4_FRONT_MEDIUM T_F_TIRE_EVAL
    tire:model "GT4_Front_medium"

Pattern GT4_REAR_MEDIUM T_R_TIRE_EVAL
	tire:model "GT4_Rear_medium"

#Wet Compound tire
Pattern GT4_FRONT_WET T_F_TIRE_EVAL
	tire:pressure 155000.0
	tire:model "GT4_Front_wet"

Pattern GT4_REAR_WET T_R_TIRE_EVAL
	tire:pressure 155000.0
	tire:model "GT4_Rear_wet"

FL_PRESSURE_RANGE = "130000 220000"
FR_PRESSURE_RANGE = "130000 220000"
RL_PRESSURE_RANGE = "130000 220000"
RR_PRESSURE_RANGE = "130000 220000"

Entity FL:tire T_F_TIRE_EVAL
Entity FR:tire T_F_TIRE_EVAL
Entity RR:tire T_R_TIRE_EVAL
Entity RL:tire T_R_TIRE_EVAL

Entity FL:soft GT4_FRONT_MEDIUM
Entity FR:soft GT4_FRONT_MEDIUM
Entity RL:soft GT4_REAR_MEDIUM
Entity RR:soft GT4_REAR_MEDIUM

Entity FL:wet GT4_FRONT_WET
Entity FR:wet GT4_FRONT_WET
Entity RL:wet GT4_REAR_WET
Entity RR:wet GT4_REAR_WET

# TIRE_ENUM_NAMES and TIRE_ENUM_TIRES should have same count
TIRE_DEFAULT=tire
TIRE_ENUM_NAMES="hard, medium, wet"
TIRE_ENUM_TIRES='$(CORNER):$(TIRE_DEFAULT)' '$(CORNER):medium' '$(CORNER):wet'

#########falloff example########
Archetype l_named_splat_real
	name
	splat:real

Entity ArbitraryFalloff l_named_splat_real
	splat:real "
		0.0,	1.0
		1000.0,	1.0
		7000.0,	1.0
		20000.0, 0.90
	"

Pattern T_F_TIRE_EVAL T_F_TIRE
	control:evaluate "
		(grip_load_scale (lookup 'ArbitraryFalloff' Fz))
		(Fx (* Fx grip_load_scale))
		(Fy (* Fy grip_load_scale))
	"

