# V8 Supercar Aerodynamics
# Based on current gen Mustang/Camaro/Supra specifications
# V8SC runs less downforce than GT3 but more than GT4
# Focus on efficiency and top speed for long straights

Entity V8SC_FW l_splat_vec2
	splat:vec2 "
		0.0,	-1.25, 0.40  # @150mph -1308N (-294 lbs) downforce, 418N (94 lbs) drag
	"
Entity V8SC_FW_ground_effect l_splat_vec3
	splat:vec3 "
		0.00, 0.0, 1.00, 0.0 # [0] distance to ground , [1] CL lift to add, [2] mutiplier to main lift from diffuser [3] ?
		0.010, 0.0, 1.08, 0.0
		0.025, 0.0, 1.05, 0.0
		0.045, 0.0, 1.03, 0.0
		0.065, 0.0, 1.00, 0.0
		0.080, 0.0, 0.96, 0.0
		0.100, 0.0, 0.92, 0.0
	"

Entity V8SC_RW l_splat_vec2
	splat:vec2 "
		# V8 Supercars: Large adjustable rear wing (gurney flaps + angle)
		# [0] degrees of wing angle, [1] CL lift [2] CD drag
		0.0,   -0.70,   0.095  # @150mph Low downforce config
		1.0,   -0.85,   0.135  # @150mph
		2.0,   -0.95,   0.160  # @150mph
		3.0,   -1.05,   0.185  # @150mph Medium downforce (typical race trim)
		4.0,   -1.15,   0.215  # @150mph
		5.0,   -1.25,   0.250  # @150mph High downforce config
		6.0,   -1.35,   0.290  # @150mph Maximum downforce
	"

Entity no_aero_yet l_splat_vec2
	splat:vec2 "
		0.0,	0.0
	"

# V8SC body drag - less refined than GT3, more drag due to homologation requirements
Entity V8SC_body_drag l_splat_vec2
	splat:vec2 "
		0.0,	0.125  # @150mph body drag split between front and rear axles
	"

Entity V8SC_diffuser_lift l_splat_vec2
	splat:vec2 "
		# V8SC diffuser - simpler than GT3 but effective
		0.0,  -0.62, 0.0 # [0] degrees of pitch, [1] CL lift [2] CD drag
		0.2,  -0.63, 0.0
		0.4,  -0.64, 0.0
		0.6,  -0.63, 0.0 # @150mph -1312N (-295 lbs) before ground effect
		0.8,  -0.62, 0.0
		1.0,  -0.63, 0.0
		1.2,  -0.64, 0.0
		1.4,  -0.65, 0.0
		1.6,  -0.64, 0.0
		1.8,  0.30, 0.0  # Stall at extreme pitch
	"

Entity V8SC_diffuser_ground_effect l_splat_vec3
	splat:vec3 "
		0.0, 0.0, 1.0, 0.0
		0.015, 0.0, 1.08, 0.0 # [0] distance to ground , [1] CL lift to add, [2] mutiplier to main lift from diffuser [3] ?
		0.025, 0.0, 1.15, 0.0
		0.035, 0.0, 1.18, 0.0
		0.045, 0.0, 1.12, 0.0
		0.055, 0.0, 1.08, 0.0
		0.070, 0.0, 1.04, 0.0
		0.090, 0.0, 1.00, 0.0
		0.110, 0.0, 0.98, 0.0
		0.130, 0.0, 0.95, 0.0
	"

Entity EZ_ground_effect l_splat_vec3
	splat:vec3 "
		0.0, 0.0, 1.0, 0.0
	"

Entity EZ_lift l_splat_vec2
	splat:vec2 "
		0.0,	-1.0,		0.5
	"

Entity test_lift l_splat_vec2
	splat:vec2 "
		0.0,	3.0,		0.0
	"

Entity simple_pitch_moment l_splat_real
	splat:real "
		0.0,	-0.1
		5.0,	-0.1
		25.0,	-0.5
	"

Entity aero:root l_aero_force_locator
	name "aero:root"
	spc:at	"0.0 0.0 0.0"
	frame:zyx "0.0 0.0 0.0"

Entity aero:FW l_aero_item
	name "aero:FW"
	aero:ClCd_x V8SC_FW
	aero:ClEff_h V8SC_FW_ground_effect
	aero:Cm		simple_pitch_moment
	bdy:length3 "0.18 1.75 0.05"               # V8SC: Moderate front splitter
	frame:zyx "0.0 0.0 0.0"
	spc:at	"1.85 0.0 -0.220"                   # mounting point x,y,z from car center
	mount:locator chassis:reference
	morph:curve aero_FW_damage_curve
	morph:scale 1.0

Entity aero:RW l_aero_item
	name "aero:RW"
	aero:ClCd_x V8SC_RW
	aero:ClCd_y no_aero_yet
	aero:ClCd_z no_aero_yet
	aero:Cm		simple_pitch_moment
	bdy:length3 "0.38 1.80 0.05"               # V8SC: Large rear wing (wider span than GT4, slightly less than GT3)
	mount:zyx "0 3 0"                          # Default 3 degrees rear wing angle
	spc:at	"-2.05 0.0 0.680"                  # Mounted high and far back
	mount:locator chassis:reference
	morph:curve aero_RW_damage_curve
	morph:scale 1.0

# Setup wing adjustment - V8SC typically runs 0-6 degrees
Entity * T_SETUP_CHANNEL
	channel:range "0 6 1"
	channel:name "R-wing-angle"
	address "aero:RW.mount:zyx[1]"

Entity aero:diffuser l_aero_item
	name "aero:diffuser"
	aero:ClCd_x V8SC_diffuser_lift
	aero:ClEff_h V8SC_diffuser_ground_effect
	aero:Cm		simple_pitch_moment
	bdy:length3 "1.0 0.65 0.2"                 # V8SC: Moderate diffuser, less complex than GT3
	frame:zyx "0.0 0.008 0.0"
	spc:at	"-0.75 0.0 -0.225"                 # Position of lift/drag effect
	mount:locator chassis:reference

Entity aero:body l_aero_item
	aero:ClCd_x V8SC_body_drag
	aero:ClCd_y V8SC_body_drag
	aero:ClCd_z V8SC_body_drag
	bdy:length3 "1.8 1.0 0.35"                 # Front body section
	frame:zyx "0.0 0.008 0.0"
	spc:at	"1.430 0.0 0.180"
	mount:locator chassis:reference

Entity aero:body2 l_aero_item
	aero:ClCd_x V8SC_body_drag
	aero:ClCd_y V8SC_body_drag
	aero:ClCd_z V8SC_body_drag
	bdy:length3 "1.8 1.0 0.35"                 # Rear body section
	frame:zyx "0.0 0.008 0.0"
	spc:at	"-1.430 0.0 0.280"
	mount:locator chassis:reference

Entity wind_tunnel l_flow_node
	aero:out_stream	"-67.0 0.0 0.0"

#Entity * l_relation
#	relation:a	wind_tunnel
#	relation:b	aero:FW

# Wheels

# Radiator
